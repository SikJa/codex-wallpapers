{
  "name": "codex-wallpapers",
  "version": "0.1.6",
  "private": true,
  "description": "Unofficial, local wallpaper customization for Codex Desktop on Windows",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/ui.mjs",
    "test:usage": "node tests/usage.mjs",
    "check": "node scripts/check.mjs && node scripts/check-docs.mjs",
    "import": "node src/cli.mjs import",
    "list": "node src/cli.mjs list",
    "apply": "node src/apply.mjs",
    "build:usage": "vite build --config vite.usage.config.mjs",
    "build:obs": "vite build --config vite.obs.config.mjs",
    "obs": "node obs-overlay/server.mjs",
    "typecheck": "tsc -p tsconfig.usage.json --noEmit"
  },
  "license": "MIT",
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.8.0",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "^6.0.2",
    "vite": "^8.2.0"
  }
}
